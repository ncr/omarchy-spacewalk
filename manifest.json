{
  "schemaVersion": 1,
  "id": "io.github.ncr.spacewalk",
  "name": "Spacewalk",
  "version": "0.1.0",
  "author": "Jacek Becela",
  "description": "Steps, calories, time and distance from a Urevo SpaceWalk 3S, with speed and incline control",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Spacewalk",
    "description": "Today's steps with a progress bar toward the goal",
    "category": "Health",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "address": "",
      "dailyGoal": 10000,
      "startSpeed": 2.5,
      "startIncline": 3,
      "strideMeters": 0,
      "phonePort": 0
    },
    "schema": [
      {
        "key": "address",
        "type": "string",
        "label": "Treadmill address (empty = scan for FTMS)"
      },
      {
        "key": "dailyGoal",
        "type": "number",
        "label": "Daily goal (steps)"
      },
      {
        "key": "startSpeed",
        "type": "number",
        "label": "Speed on start (km/h)"
      },
      {
        "key": "startIncline",
        "type": "number",
        "label": "Incline on start (%)"
      },
      {
        "key": "strideMeters",
        "type": "number",
        "label": "Stride length in metres (0 = steps from the treadmill)"
      },
      {
        "key": "phonePort",
        "type": "number",
        "label": "Apple Health sync port (0 = off)"
      }
    ]
  }
}
